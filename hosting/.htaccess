# GirlCare72 on Hostinger (Apache / LiteSpeed)
#
#   /                 website            index.html + assets/
#   /downloads/       Android app        GirlCare72.apk
#   /app/             app in the browser index.html + static/

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Always use HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The QR code and old links use /GirlCare72.apk: serve the file from downloads/
RewriteRule ^GirlCare72\.apk$ downloads/GirlCare72.apk [L]

# Browser app: unknown paths under /app/ open the app
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^app/ app/index.html [L]

# File types
AddType application/vnd.android.package-archive .apk
AddType application/wasm .wasm
AddType application/javascript .js .mjs
AddType application/json .json
AddType image/svg+xml .svg
AddType font/otf .otf
AddType font/ttf .ttf

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/wasm image/svg+xml font/otf font/ttf
</IfModule>

<IfModule mod_headers.c>
  # Privacy and safety
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"

  # The APK downloads as a file, and phones always get the newest one
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment"
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Pages, scripts and data that change with each update: always check for a new version
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Images, fonts and the browser app's engine: cache for a week
  <FilesMatch "\.(png|jpg|svg|ico|otf|ttf|woff2?|wasm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
